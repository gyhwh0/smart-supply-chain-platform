.search{display:flex;align-items:center;background:#fff;border-radius:16rpx;padding:0 22rpx;height:82rpx}.search input{flex:1}.search text{color:#1677ff}.categories{white-space:nowrap;padding:22rpx 0}.categories text{display:inline-block;padding:12rpx 24rpx;background:#fff;border-radius:28rpx;margin-right:12rpx}.categories .active{background:#1677ff;color:#fff}.product{display:flex;padding:18rpx}.product image,.no-image{width:190rpx;height:190rpx;border-radius:14rpx;flex:none}.no-image{display:flex;align-items:center;justify-content:center;background:#eef1f5;color:#a2acb8;font-size:22rpx}.content{padding-left:20rpx;flex:1;min-width:0}.name{font-size:32rpx;font-weight:700}.category{font-size:22rpx;margin:6rpx 0}.desc{font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.unit{margin-top:12rpx;background:#f3f6fa;padding:9rpx 12rpx;border-radius:8rpx;font-size:23rpx}.bottom{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx}.bottom button{margin:0}
