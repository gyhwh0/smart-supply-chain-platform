DATABASE_URL=sqlite:///./procurement.db
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=24

# Temporary development switch. Set to false to restore the normal login page.
SKIP_LOGIN=true

# Optional: AI analysis works without these values and returns deterministic results.
LLM_API_KEY=
LLM_MODEL=agnes-3.0-flash
LLM_BASE_URL=https://apihub.agnes-ai.com/v1

# Inventory natural-language keyword extraction uses an independent DeepSeek account.
INVENTORY_LLM_API_KEY=
INVENTORY_LLM_MODEL=deepseek-chat
INVENTORY_LLM_BASE_URL=https://api.deepseek.com

# Enterprise WeChat Customer Service callback and message API.
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# Speech-to-text API used for Enterprise WeChat voice orders and complaints.
# This must be a provider/model that supports OpenAI-compatible audio transcriptions.
VOICE_API_KEY=
VOICE_MODEL=whisper-1
VOICE_BASE_URL=https://api.openai.com/v1
