.head,.line,.amount{display:flex;justify-content:space-between;align-items:center}.head{margin-bottom:8rpx}.number{font-weight:700}.status{color:#1677ff}.line{padding:16rpx 0;border-bottom:1rpx solid #f0f2f5;font-size:25rpx}.amount{justify-content:flex-end;padding-top:18rpx}.amount .price{font-size:34rpx;margin-left:10rpx}.addition{display:inline-block;margin-left:10rpx;padding:4rpx 10rpx;border-radius:8rpx;background:#fff0e8;color:#e45f27;font-size:21rpx}.addition.small{margin-left:8rpx}.remark{color:#8b95a4;font-size:21rpx;margin-top:6rpx;max-width:360rpx}.line>view{width:48%}
