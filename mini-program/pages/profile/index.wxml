<view class="page"><view class="profile card"><view class="avatar">{{initial}}</view><view><view class="section-title">{{profile.customer.name || '尚未绑定客户'}}</view><view class="muted">{{profile.customer.customer_code || '绑定后即可在线下单'}}</view></view></view><view wx:if="{{profile.bound}}" class="card"><view class="item"><text>联系人</text><text>{{profile.customer.contact_name || '—'}}</text></view><view class="item"><text>预留电话</text><text>{{profile.customer.phone || '—'}}</text></view></view><button wx:if="{{!profile.bound}}" class="primary" bindtap="goBind">绑定客户档案</button><button bindtap="refresh">重新登录并刷新</button><button wx:if="{{profile.bound}}" class="logout" bindtap="logoutAccount">退出登录</button></view>
