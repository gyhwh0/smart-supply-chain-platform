<view class="page"><view wx:if="{{!orders.length}}" class="empty">暂无订单</view><view wx:for="{{orders}}" wx:key="id" class="card"><view class="head"><view><text class="number">{{item.order_no}}</text><text wx:if="{{item.has_additions}}" class="addition">含加单</text></view><text class="status">{{item.statusText}}</text></view><view class="muted">下单 {{item.order_date}} · 配送 {{item.delivery_date || item.order_date}}</view><view class="line" wx:for="{{item.items}}" wx:for-item="goods" wx:key="name"><view><text>{{goods.name}}</text><text wx:if="{{goods.is_addition}}" class="addition small">加单</text><view wx:if="{{goods.remark}}" class="remark">备注：{{goods.remark}}</view></view><text>{{goods.quantity}} {{goods.unit_name}}</text><text>¥{{goods.amount}}</text></view><view class="amount">共 {{item.items.length}} 种商品，合计 <text class="price">¥{{item.total_amount}}</text></view></view></view>
