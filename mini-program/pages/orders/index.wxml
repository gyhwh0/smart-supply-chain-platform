<view class="page"><view wx:if="{{!orders.length}}" class="empty">暂无订单</view><view wx:for="{{orders}}" wx:key="id" class="card"><view class="head"><text class="number">{{item.order_no}}</text><text class="status">{{item.statusText}}</text></view><view class="muted">下单 {{item.order_date}} · 配送 {{item.delivery_date || item.order_date}}</view><view class="line" wx:for="{{item.items}}" wx:for-item="goods" wx:key="name"><text>{{goods.name}}</text><text>{{goods.quantity}} {{goods.unit_name}}</text><text>¥{{goods.amount}}</text></view><view class="amount">共 {{item.items.length}} 种商品，合计 <text class="price">¥{{item.total_amount}}</text></view></view></view>
